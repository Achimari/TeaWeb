# Use "demo" for a browser-only preview. Set to "supabase" before building a shared deployment.
NEXT_PUBLIC_TEA_MODE=demo
# Shared line: set the mode to "supabase" and both server-only values below. The service-role key is
# used only inside the API routes and must never get a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Business day for the daily archive (IANA timezone). Also set app_settings.business_timezone in the database.
NEXT_PUBLIC_BUSINESS_TIMEZONE=Europe/Riga
