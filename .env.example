# Server-only settings. None of these reach the browser; never give them a NEXT_PUBLIC_ prefix.

# The shared PostgreSQL database (the line, the first-five archive, the shared tea timer, rate limits).
# Local: `npm run db:up` starts PostgreSQL 17 in Docker with exactly these credentials.
DATABASE_URL="postgresql://tea:tea@127.0.0.1:5433/tea"

# Business day for the daily line and archive (IANA timezone). Europe/Riga by default, daylight-saving included.
BUSINESS_TIMEZONE="Europe/Riga"

# Optional: how many places the line has per day (default 500).
# LINE_CAPACITY=500

# Tests only: a PostgreSQL server where tests may create and drop throwaway databases.
TEST_DATABASE_URL="postgresql://tea:tea@127.0.0.1:5433/postgres"
